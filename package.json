  "description": "Focused Godot engine inspection, validation and play-session feedback for development with Codex in Rider.",
  "keywords": [
    "godot",
    "mcp",
    "ai",
    "codex",
    "rider"
  ],
  "homepage": "https://github.com/Coding-Solo/godot-mcp",
